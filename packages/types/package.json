    "generate": "tsx scripts/generate.ts",
    "verify": "tsx scripts/verify-demo.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "viem": "^2.37.0"
  }
}
