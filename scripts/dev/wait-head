#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
source scripts/dev/env
for i in {1..40}; do
  if docker compose exec -T api node -e 'const h=await (await fetch(`http://127.0.0.1:${process.env.API_PORT}/health`)).json(); if(!h.ok||h.indexedBlock!==h.headBlock)process.exit(1)' --input-type=module; then exit 0; fi
  sleep 1
done
echo 'backend boundary: indexer did not reach head in 40s' >&2
exit 1
