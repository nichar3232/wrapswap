#!/usr/bin/env bash
# Lane defaults; all listeners and published ports use these variables.
export ANVIL_PORT=${ANVIL_PORT:-18508} PG_PORT=${PG_PORT:-15408}
export API_PORT=${API_PORT:-18008} WEB_PORT=${WEB_PORT:-13008}
export CRANK_HEALTH_PORT=${CRANK_HEALTH_PORT:-18108}
export COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-wrapswap-integration}
# Unichain Sepolia (1301) is the default network; the compose scripts (up, reset, demo-check, ...) pin NETWORK=anvil.
export NETWORK=${NETWORK:-unichain-sepolia} USE_MOCKS=false
export DEMO_MNEMONIC=${DEMO_MNEMONIC:-'test test test test test test test test test test test junk'}
if [[ $NETWORK == unichain-sepolia ]]; then export RPC_URL=${RPC_URL:-https://sepolia.unichain.org}; else export RPC_URL=${RPC_URL:-http://127.0.0.1:$ANVIL_PORT}; fi
export LOCAL_RPC=$RPC_URL
export DATABASE_URL=postgresql://wrapswap:wrapswap@127.0.0.1:$PG_PORT/wrapswap
export DEPLOYMENT_FILE=deployments/$NETWORK.json
export CRANK_PORT=$CRANK_HEALTH_PORT
