{
  "name": "@wrapswap/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unison MCP server: read pools, quote and execute share-for-share conversions and dark-cross orders over the public Unison API.",
  "bin": {
    "unison-mcp": "./src/stdio.ts"
  },
  "scripts": {
    "start:stdio": "tsx src/stdio.ts",
    "start:http": "tsx src/http.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
