#!/usr/bin/env bash
# Verifies every contract created by the latest Deploy.s.sol (or the script named in $1, e.g. UpgradeFees.s.sol)
# broadcast on Unichain Sepolia (Etherscan v2 API). Env: ETHERSCAN_API_KEY (Etherscan v2 key), RPC_URL.
set -euo pipefail
cd "$(dirname "$0")/../.."
: "${ETHERSCAN_API_KEY:?}" "${RPC_URL:?}"
broadcast=broadcast/${1:-Deploy.s.sol}/1301/run-latest.json
declare -A src=(
  [PoolSwapTest]=lib/v4-core/src/test/PoolSwapTest.sol
  [PoolModifyLiquidityTest]=lib/v4-core/src/test/PoolModifyLiquidityTest.sol
  [IssuerRegistry]=contracts/src/IssuerRegistry.sol
  [NyseCalendar]=contracts/src/NyseCalendar.sol
  [EASEligibility]=contracts/src/EASEligibility.sol
  [MockPriceOracle]=contracts/src/mocks/MockPriceOracle.sol
  [MockIssuerToken]=contracts/src/mocks/MockIssuerToken.sol
  [B20MultiplierAdapter]=contracts/src/adapters/B20MultiplierAdapter.sol
  [XStocksMultiplierAdapter]=contracts/src/adapters/XStocksMultiplierAdapter.sol
  [ParityHook]=contracts/src/ParityHook.sol
  [DarkCrossHook]=contracts/src/DarkCrossHook.sol
  [WrapSwapRouter]=contracts/src/WrapSwapRouter.sol
  [TestShareFaucet]=contracts/src/mocks/TestShareFaucet.sol
)
failed=0
while IFS=$'\t' read -r name address hash; do
  # Constructor args are the creation input after the compiled initcode (CREATE2: after the 32-byte salt too).
  input=$(cast tx "$hash" input --rpc-url "$RPC_URL")
  initcode=$(jq -r .bytecode.object "contracts/out/$(basename "${src[$name]}")/$name.json")
  data=${input#0x}
  [[ $name == ParityHook ]] && data=${data:64}
  args=${data:$(( ${#initcode} - 2 ))}
  echo "== $name $address"
  if forge verify-contract "$address" "${src[$name]}:$name" --chain 1301 --verifier etherscan \
      --etherscan-api-key "$ETHERSCAN_API_KEY" --constructor-args "0x$args" --watch; then :; else failed=1; fi
done < <(jq -r '.transactions[] | select(.transactionType=="CREATE" or .transactionType=="CREATE2") | [.contractName, .contractAddress, .hash] | @tsv' "$broadcast")
exit $failed
