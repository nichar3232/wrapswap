{
  "name": "@wrapswap/types",
  "version": "1.0.0",
  "private": true,
  "description": "Frozen WrapSwap interfaces: ABIs, event topics, deployment and API types with runtime validators, demo constants.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
