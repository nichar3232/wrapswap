#!/usr/bin/env bash
# Read-only Unichain Sepolia smoke checks against deployments/unichain-sepolia.json (final shape:
# {chainId, deployBlock, router, faucet, protocolFeeRecipient, assets[{symbol, wrappers[], pool, parityHook, darkCross}]}).
# Env: RPC_URL. Per asset: code at every address, ParityHook flags, pool at parity (peg deviation), stocked inventory, skew.
set -euo pipefail
cd "$(dirname "$0")/../.."
: "${RPC_URL:?}"
m=deployments/unichain-sepolia.json
fail=0
ok() { printf 'PASS %s\n' "$1"; }
bad() { printf 'FAIL %s\n' "$1"; fail=1; }
[[ $(cast chain-id --rpc-url "$RPC_URL") == 1301 ]] && ok 'chainId 1301' || bad 'chainId'
for a in $(jq -r '[.router, .faucet, (.assets[] | .parityHook, .darkCross, (.wrappers[] | .token, .adapter))] | unique | .[]' "$m"); do
  [[ $(cast code "$a" --rpc-url "$RPC_URL") != 0x ]] && ok "code $a" || bad "code $a"
done
for row in $(jq -r '.assets[] | "\(.symbol):\(.parityHook):\(.darkCross):\(.wrappers[0].token):\(.wrappers[1].token)"' "$m"); do
  IFS=: read -r sym hook dark w0 w1 <<<"$row"
  flags=$(( $(cast to-dec "$hook") & 0x3fff ))
  [[ $flags == $((0x20c8)) ]] && ok "$sym hook flags 0x20c8" || bad "$sym hook flags $flags"
  c0=$w0 c1=$w1; [[ $(tr A-F a-f <<<"$w0") > $(tr A-F a-f <<<"$w1") ]] && { c0=$w1; c1=$w0; }
  key="($c0,$c1,8388608,10,$hook)"
  dev=$(cast call "$hook" 'pegStatus((address,address,uint24,int24,address))((uint256,uint256,uint256,bool))' "$key" --rpc-url "$RPC_URL" | tr -d '()' | awk -F', ' '{print $3}' | awk '{print $1}')
  [[ $dev -le 50 ]] && ok "$sym pool within peg guard (deviation ${dev} bps)" || bad "$sym pool deviation ${dev} bps"
  i0=$(cast call "$hook" 'inventory(address)(uint256)' "$c0" --rpc-url "$RPC_URL" | awk '{print $1}')
  i1=$(cast call "$hook" 'inventory(address)(uint256)' "$c1" --rpc-url "$RPC_URL" | awk '{print $1}')
  skew=$(cast call "$hook" 'feeBreakdown((address,address,uint24,int24,address))((uint24,uint24,uint24,int256,int256,bool))' "$key" --rpc-url "$RPC_URL" | tr -d '()' | awk -F', ' '{print $4}' | awk '{print $1}')
  [[ $i0 != 0 && $i1 != 0 ]] && ok "$sym inventory $i0 / $i1, skewX18 $skew" || bad "$sym inventory $i0 / $i1"
  [[ $(cast call "$dark" 'asset()(bytes32)' --rpc-url "$RPC_URL" | cast parse-bytes32-string) == "$sym" ]] && ok "$sym DarkCrossHook asset" || bad "$sym DarkCrossHook asset"
done
exit $fail
