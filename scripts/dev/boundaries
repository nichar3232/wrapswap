#!/usr/bin/env bash
# Read-only boundary audit. Every hit is an independently reproducible component mismatch.
set -u
cd "$(dirname "$0")/../.."
failed=0
check() {
  local id=$1 pattern=$2; shift 2
  if rg -n "$pattern" "$@"; then printf 'FAIL %s\n' "$id"; failed=1; else printf 'PASS %s\n' "$id"; fi
}
check C01 'Unsupported chain|deployments/local.json|_key\(vault' contracts/script/Addresses.sol contracts/script/Deploy.s.sol
check C02 'CanonicalStock|feeBps|Converted' contracts/src/ParityHook.sol
check C03 'usdc|USDC|Chainlink' contracts/src/DarkCrossHook.sol
check C04 'sharesPerToken|ERC20\(' contracts/src/mocks/MockIssuerToken.sol contracts/src/mocks/MockB20.sol
check C05 'AggregatorV3|latestRoundData' contracts/src/mocks/MockOracle.sol
check C06 'IIssuerAdapter' contracts/src/adapters contracts/src/IssuerRegistry.sol
check B01 'deployments/local.json|LOCAL_RPC|deployments/abis' api/src/chain/client.ts
check B02 '"/parity"|"/backing"|error:.*message' api/src/routes/index.ts api/src/index.ts
check B03 'conversions|crossed_qty|mid_source' api/src/db/schema.sql api/src/indexer/index.ts
check B04 'startIndexer\(' api/src/index.ts
check B05 'CRANK_PORT|DEPLOYER_PK|current - 1n' services/crank/index.ts
check W01 'Backing|USDC|uAAPL|vault' web/src/main.tsx
exit "$failed"
