#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
# The compose stack is the offline anvil backup; the public network (unichain-sepolia) is the env default.
export NETWORK=${NETWORK:-anvil}
source scripts/dev/env
scripts/dev/up
for run in 1 2 3; do
  scripts/dev/reset
  DEMO_RUN=$run npx playwright test e2e/demo.spec.ts --workers=1
done
diff -u logs/integration/run-1.json logs/integration/run-2.json
diff -u logs/integration/run-1.json logs/integration/run-3.json
npx playwright test e2e/scenarios --workers=1
